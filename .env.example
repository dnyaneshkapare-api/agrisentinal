# AgriSentinel AI: Environment Variable Configuration
# Never commit real credentials or .env files to source control.
# In production, variables must be injected via Secret Manager / runtime environment.

# GEMINI_API_KEY: Required for multimodal vision diagnosis & evidence reasoning
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for this applet instance
APP_URL="MY_APP_URL"

# Application Environment (development | staging | production)
APP_ENV="development"
DEBUG="true"

# Server Port & API
PORT="3000"
API_BASE_URL="http://localhost:3000"

# Security & CORS
ALLOWED_ORIGINS="http://localhost:3000"
COOKIE_DOMAIN=""
CSRF_SECRET=""
SESSION_TTL="900"

# JWT Secret (minimum 32 characters in production)
JWT_SECRET=""

# Rate Limiting configuration
RATE_LIMIT_GLOBAL="120/minute"
RATE_LIMIT_DIAGNOSE="15/minute"
RATE_LIMIT_RECOMMEND="20/minute"

# Database & Cache (PostgreSQL / PostGIS & Redis in production)
DATABASE_URL=""
REDIS_URL=""

# Object Storage (S3 / GCS for compressed farmer leaf images)
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# External APIs (Used server-side only through proxy routes)
WEATHER_API_KEY=""
MAP_API_KEY=""
MODEL_REGISTRY_URI="models/agrisentinel-v1.4-onnx"

